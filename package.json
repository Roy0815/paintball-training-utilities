{
  "name": "paintball-training-utilities",
  "version": "0.0.0",
  "description": "Multi tool PWA for paintball training. On-device ML, no backend.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tunnel": "node scripts/tunnel-qr.mjs",
    "dev:phone": "concurrently -n vite,tunnel -c blue,green \"npm:dev\" \"npm:tunnel\""
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.5",
    "qrcode-terminal": "^0.12.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "idb": "^8.0.3"
  }
}
