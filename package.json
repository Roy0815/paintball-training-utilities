{
  "name": "paintball-training-utilities",
  "version": "0.0.0",
  "description": "Multi tool PWA for paintball training. On-device ML, no backend.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run docs:build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-src",
    "docs:build": "vitepress build docs-src",
    "docs:preview": "vitepress preview docs-src",
    "tunnel": "node scripts/tunnel-qr.mjs",
    "dev:phone": "concurrently -n vite,tunnel -c blue,green \"npm:dev\" \"npm:tunnel\"",
    "generate:numbers": "node scripts/generate-number-clips.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "qrcode-terminal": "^0.12.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "idb": "^8.0.3"
  }
}
